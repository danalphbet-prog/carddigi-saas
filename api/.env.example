# Configure as variáveis no Render Web Service da API, não no Static Site.
FIREBASE_DATABASE_URL=https://carddigi-default-rtdb.firebaseio.com
ALLOWED_ORIGINS=https://SEU-STATIC-SITE.onrender.com,http://localhost:5173
ENFORCE_APP_CHECK=false
# Render: valor secreto JSON da conta de serviço (não coloque no repositório).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local Termux: alternativa ao JSON inline, fora do repositório.
# GOOGLE_APPLICATION_CREDENTIALS=/home/seu-usuario/.config/carddigi/service-account.json
PORT=3001
