{
  "rules": {
    ".read": false,
    ".write": false,
    "publicMenus": {
      "$rid": {
        ".read": "data.child('published').val() === true",
        ".write": false
      }
    },
    "slugIndex": {
      ".read": true,
      ".write": false
    },
    "settings": {
      "site": {
        ".read": true,
        ".write": false
      }
    },
    "modelCatalog": {
      ".read": "auth != null",
      ".write": false
    },
    "restaurants": {
      ".indexOn": [
        "ownerUid"
      ],
      ".read": "auth != null && (auth.token.platformAdmin === true || (query.orderByChild === 'ownerUid' && query.equalTo === auth.uid))",
      "$rid": {
        ".read": "auth != null && (auth.token.platformAdmin === true || data.child('ownerUid').val() === auth.uid)",
        ".write": false
      }
    },
    "modelRequests": {
      ".indexOn": [
        "ownerUid"
      ],
      ".read": "auth != null && (auth.token.platformAdmin === true || (query.orderByChild === 'ownerUid' && query.equalTo === auth.uid))",
      "$requestId": {
        ".write": false
      }
    },
    "publicationRequests": {
      ".indexOn": [
        "ownerUid"
      ],
      ".read": "auth != null && (auth.token.platformAdmin === true || (query.orderByChild === 'ownerUid' && query.equalTo === auth.uid))",
      "$requestId": {
        ".write": false
      }
    },
    "analytics": {
      ".read": "auth != null && auth.token.platformAdmin === true",
      "$rid": {
        ".read": "auth != null && (auth.token.platformAdmin === true || root.child('restaurants').child($rid).child('ownerUid').val() === auth.uid)",
        ".write": false
      }
    },
    "orders": {
      "$rid": {
        ".read": "auth != null && (auth.token.platformAdmin === true || root.child('restaurants').child($rid).child('ownerUid').val() === auth.uid)",
        ".write": false
      }
    },
    "integrations": {
      "$rid": {
        ".read": "auth != null && (auth.token.platformAdmin === true || root.child('restaurants').child($rid).child('ownerUid').val() === auth.uid)",
        ".write": false
      }
    },
    "commerce": {
      ".read": false,
      ".write": false
    },
    "metricsDaily": {
      "$rid": {
        ".read": "auth != null && (auth.token.platformAdmin === true || root.child('restaurants').child($rid).child('ownerUid').val() === auth.uid)",
        ".write": false
      }
    },
    "auditLogs": {
      ".read": "auth != null && auth.token.platformAdmin === true",
      ".write": false
    }
  }
}
